{
  "name": "automation-builder-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone copy of the Admanage automation builder, running on mock data.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
